+import { describe, it, expect } from "vitest";
+import {
+  isSponsorActiveOn,
+  isSponsorExcludedPath,
+  pickRotatedSponsor,
+  sponsorsForPopup,
+  sponsorsForBand,
+  filterActiveSponsors,
+  isAllowedSponsorImageType,
+} from "../logic";
+
+const base = {
+  id: "1",
+  nom: "Acme",
+  image_url: "https://example.com/a.png",
+  actif: true,
+  ordre: 0,
+  afficher_popup: true,
+  afficher_bande: true,
+};
+
+describe("isSponsorExcludedPath", () => {
+  it("exclut inscription, admin, certificat", () => {
+    expect(isSponsorExcludedPath("/inscription")).toBe(true);
+    expect(isSponsorExcludedPath("/inscription?course=x")).toBe(true);
+    expect(isSponsorExcludedPath("/admin")).toBe(true);
+    expect(isSponsorExcludedPath("/admin/foo")).toBe(true);
+    expect(isSponsorExcludedPath("/certificat")).toBe(true);
+  });
+  it("autorise l'accueil et partenaires", () => {
+    expect(isSponsorExcludedPath("/")).toBe(false);
+    expect(isSponsorExcludedPath("/partenaires")).toBe(false);
+    expect(isSponsorExcludedPath("/courses")).toBe(false);
+  });
+});
+
+describe("isSponsorActiveOn", () => {
+  const day = new Date(Date.UTC(2026, 10, 11)); // 11 nov 2026
+  it("respecte actif=false", () => {
+    expect(isSponsorActiveOn({ ...base, actif: false }, day)).toBe(false);
+  });
+  it("respecte date_debut / date_fin", () => {
+    expect(
+      isSponsorActiveOn({ ...base, date_debut: "2026-11-12", date_fin: null }, day)
+    ).toBe(false);
+    expect(
+      isSponsorActiveOn({ ...base, date_debut: "2026-11-01", date_fin: "2026-11-11" }, day)
+    ).toBe(true);
+    expect(
+      isSponsorActiveOn({ ...base, date_debut: null, date_fin: "2026-11-10" }, day)
+    ).toBe(false);
+  });
+});
+
+describe("rotation et filtres", () => {
+  const list = [
+    { ...base, id: "a", ordre: 1, afficher_popup: true, afficher_bande: false },
+    { ...base, id: "b", ordre: 0, afficher_popup: true, afficher_bande: true },
+    { ...base, id: "c", ordre: 2, afficher_popup: false, afficher_bande: true },
+  ];
+  it("ordonne et filtre", () => {
+    const act = filterActiveSponsors(list);
+    expect(act.map((s) => s.id)).toEqual(["b", "a", "c"]);
+    expect(sponsorsForPopup(list).map((s) => s.id)).toEqual(["b", "a"]);
+    expect(sponsorsForBand(list).map((s) => s.id)).toEqual(["b", "c"]);
+  });
+  it("rotation cyclique", () => {
+    const pop = sponsorsForPopup(list);
+    expect(pickRotatedSponsor(pop, 0)?.id).toBe("b");
+    expect(pickRotatedSponsor(pop, 1)?.id).toBe("a");
+    expect(pickRotatedSponsor(pop, 2)?.id).toBe("b");
+    expect(pickRotatedSponsor([], 0)).toBeNull();
+  });
+});
+
+describe("images", () => {
+  it("accepte png jpeg webp seulement", () => {
+    expect(isAllowedSponsorImageType("image/png")).toBe(true);
+    expect(isAllowedSponsorImageType("image/svg+xml")).toBe(false);
+  });
+});
diff --git a/src/lib/sponsors/logic.ts b/src/lib/sponsors/logic.ts
new file mode 100644
index 0000000..bc822dc
--- /dev/null
+++ b/src/lib/sponsors/logic.ts
@@ -0,0 +1,95 @@
+/** Logique pure sponsors (dates, rotation, pages exclues) — testable sans UI. */
+
+export type SponsorRecord = {
+  id: string;
+  nom: string;
+  image_url: string;
+  site_url?: string | null;
+  date_debut?: string | null;
+  date_fin?: string | null;
+  actif: boolean;
+  ordre: number;
+  afficher_popup?: boolean;
+  afficher_bande?: boolean;
+  vues?: number;
+  clics?: number;
+};
+
+/** Pages où le pop-up et la bande ne doivent pas apparaître. */
+export const SPONSOR_EXCLUDED_PATHS = [
+  "/inscription",
+  "/admin",
+  "/certificat",
+] as const;
+
+export function isSponsorExcludedPath(pathname: string): boolean {
+  const p = (pathname || "/").split("?")[0].replace(/\/$/, "") || "/";
+  if (p === "/admin" || p.startsWith("/admin/")) return true;
+  if (p === "/inscription" || p.startsWith("/inscription/")) return true;
+  if (p === "/certificat" || p.startsWith("/certificat/")) return true;
+  // pas de page paiement dédiée ; si ajoutée plus tard, l'exclure ici
+  if (p.startsWith("/api/")) return true;
+  return false;
+}
+
+function parseDateOnly(s: string | null | undefined): Date | null {
+  if (!s) return null;
+  const m = String(s).slice(0, 10).match(/^(\d{4})-(\d{2})-(\d{2})$/);
+  if (!m) return null;
+  return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
+}
+
+/** Actif selon flag + fenêtre de dates (inclusives), jour UTC. */
+export function isSponsorActiveOn(
+  s: Pick<SponsorRecord, "actif" | "date_debut" | "date_fin">,
+  now: Date = new Date()
+): boolean {
+  if (!s.actif) return false;
+  const day = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
+  const debut = parseDateOnly(s.date_debut);
+  const fin = parseDateOnly(s.date_fin);
+  if (debut && day < debut.getTime()) return false;
+  if (fin && day > fin.getTime()) return false;
+  return true;
+}
+
+export function filterActiveSponsors(
+  list: SponsorRecord[],
+  now: Date = new Date()
+): SponsorRecord[] {
+  return list
+    .filter((s) => isSponsorActiveOn(s, now))
+    .sort((a, b) => (a.ordre ?? 0) - (b.ordre ?? 0));
+}
+
+export function sponsorsForPopup(list: SponsorRecord[], now?: Date): SponsorRecord[] {
+  return filterActiveSponsors(list, now).filter((s) => s.afficher_popup);
+}
+
+export function sponsorsForBand(list: SponsorRecord[], now?: Date): SponsorRecord[] {
+  return filterActiveSponsors(list, now).filter((s) => s.afficher_bande);
+}
+
+/**
+ * Rotation : un seul sponsor par visite.
+ * index stocké côté client (sessionStorage) ; on avance à chaque nouvelle visite.
+ */
+export function pickRotatedSponsor(
+  candidates: SponsorRecord[],
+  rotationIndex: number
+): SponsorRecord | null {
+  if (!candidates.length) return null;
+  const i = ((rotationIndex % candidates.length) + candidates.length) % candidates.length;
+  return candidates[i];
+}
+
+export const MAX_SPONSOR_IMAGE_BYTES = 2 * 1024 * 1024; // 2 Mo
+export const ALLOWED_SPONSOR_IMAGE_TYPES = [
+  "image/jpeg",
+  "image/png",
+  "image/webp",
+] as const;
+
+export function isAllowedSponsorImageType(mime: string): boolean {
+  return (ALLOWED_SPONSOR_IMAGE_TYPES as readonly string[]).includes(mime);
+}
