+      <section className="border border-stone-200 rounded-2xl p-5 space-y-3 max-w-xl">
+        <h3 className="font-semibold">{editId ? "Modifier" : "Ajouter"} un sponsor</h3>
+        <input
+          className="w-full border rounded-lg px-3 py-2 text-sm"
+          placeholder="Nom *"
