+            <p>
+              Lignes : {preview.total} · Finishers : {preview.finishers} · OK :{" "}
+              {preview.ok ? "oui" : "non"}
+            </p>
+            {(preview.errors || []).map((e: string, i: number) => (
+              <p key={i} className="text-red-700">
+                {e}
+              </p>
