+                  await fetch("/api/admin/sponsors", {
+                    method: "POST",
+                    headers: { "Content-Type": "application/json" },
+                    body: JSON.stringify({ action: "delete", id: s.id }),
+                  });
+                  await load();
+                }}
+              >
+                Supprimer
+              </button>
+            </div>
+          </div>
+        ))}
+      </section>
+    </div>
+  );
+}
